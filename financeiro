<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Financeiro - MinuT&Ra</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-storage.js"></script>
<script>
const SENHA_FIN="minutera2026";
const firebaseConfig={apiKey:"AIzaSyCTEXeRjxq0_3doBNyWm5AkQ0kmBXmjlSk",authDomain:"placar-minutera.firebaseapp.com",databaseURL:"https://placar-minutera-default-rtdb.firebaseio.com",projectId:"placar-minutera",storageBucket:"placar-minutera.firebasestorage.app",messagingSenderId:"689991648080",appId:"1:689991648080:web:9deeb958183eae23e255"};
firebase.initializeApp(firebaseConfig);
</script>
</head>
<body class="bg-black text-white min-h-screen font-sans">

<div id="login" class="flex flex-col items-center justify-center min-h-screen p-4">
  <h1 class="text-3xl font-black text-yellow-400 mb-2">💰 FINANCEIRO</h1>
  <p class="text-zinc-500 text-sm mb-6">MinuT&Ra - Acesso Restrito</p>
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-sm">
    <input id="senha" type="password" placeholder="Senha: minutera2026" class="w-full p-4 rounded-xl bg-zinc-800 border border-zinc-700 mb-3">
    <button onclick="entrar()" class="w-full bg-green-600 py-4 rounded-xl font-black">DESBLOQUEAR</button>
    <p id="erro" class="text-red-500 text-xs mt-3 hidden text-center">Senha incorreta!</p>
  </div>
</div>

<div id="app" class="hidden max-w-2xl mx-auto p-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-xl font-black text-yellow-400">💰 FINANCEIRO</h1>
    <button onclick="location.reload()" class="text-xs bg-zinc-800 px-3 py-1 rounded-full">Sair</button>
  </div>

  <div class="bg-zinc-900 border-2 border-green-600 rounded-2xl p-5 mb-6">
    <h2 class="font-bold mb-4 text-green-400">+ Novo Lançamento</h2>
    <input id="desc" placeholder="Descrição (ex: Aluguel quadra, Inscrições)" class="w-full p-3 rounded-xl bg-zinc-800 border border-zinc-700 mb-2">
    <div class="grid grid-cols-2 gap-2 mb-2">
      <input id="valor" type="number" step="0.01" placeholder="Valor (- despesa)" class="p-3 rounded-xl bg-zinc-800 border border-zinc-700">
      <input id="data" type="date" class="p-3 rounded-xl bg-zinc-800 border border-zinc-700">
    </div>
    <select id="tipo" class="w-full p-3 rounded-xl bg-zinc-800 border border-zinc-700 mb-3">
      <option value="despesa">🔴 Despesa</option>
      <option value="receita">🟢 Receita</option>
    </select>
    <label class="text-xs text-yellow-400">📎 Comprovante (PDF/Foto do Pix)</label>
    <input id="file" type="file" accept=".pdf,image/*" class="w-full p-2 rounded-xl bg-zinc-800 border border-zinc-700 mb-2">
    <p id="status" class="text-xs text-zinc-500 mb-2"></p>
    <button id="btn" onclick="salvar()" class="w-full bg-green-600 py-4 rounded-xl font-black text-lg">💾 SALVAR COM COMPROVANTE</button>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
    <h2 class="font-bold mb-3">Histórico</h2>
    <div id="lista" class="space-y-2 max-h-[50vh] overflow-y-auto"></div>
    <div class="mt-4 pt-4 border-t border-zinc-800 flex justify-between text-xl font-black">
      <span>SALDO:</span><span id="saldo">R$ 0,00</span>
    </div>
  </div>

  <p class="text-[10px] text-zinc-600 mt-6 text-center">Bucket: placar-minutera.firebasestorage.app | Storage com regras allow true</p>
</div>

<script>
const db=firebase.database(); const storage=firebase.storage();
function entrar(){
  if(document.getElementById('senha').value===SENHA_FIN){
    document.getElementById('login').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    carregar();
  } else document.getElementById('erro').classList.remove('hidden');
}
document.getElementById('senha').addEventListener('keydown',e=>{if(e.key==='Enter') entrar();});

async function salvar(){
  const desc=document.getElementById('desc').value.trim();
  const valor=parseFloat(document.getElementById('valor').value);
  const data=document.getElementById('data').value;
  const tipo=document.getElementById('tipo').value;
  const file=document.getElementById('file').files[0];
  if(!desc||isNaN(valor)||!data){alert('Preencha descrição, valor e data');return;}
  const btn=document.getElementById('btn'); btn.innerText='⏳ ENVIANDO...'; btn.disabled=true;
  let url=''; let nomeArq='';
  try{
    if(file){
      document.getElementById('status').innerText='📤 Enviando '+file.name+'...';
      nomeArq=Date.now()+'_'+file.name.replace(/[^a-z0-9._-]/gi,'_');
      const ref=storage.ref('comprovantes/'+nomeArq);
      await ref.put(file);
      url=await ref.getDownloadURL();
      document.getElementById('status').innerText='✅ Comprovante OK';
    }
    await db.ref('FINANCEIRO').push({desc,valor,data,tipo,urlComprovante:url,nomeArquivo:nomeArq,timestamp:Date.now()});
    document.getElementById('desc').value='';document.getElementById('valor').value='';document.getElementById('file').value='';document.getElementById('status').innerText='✅ Salvo!';
    setTimeout(()=>document.getElementById('status').innerText='',3000);
    carregar();
  }catch(e){alert('Erro: '+e.message);document.getElementById('status').innerText='❌ '+e.message;}
  btn.innerText='💾 SALVAR COM COMPROVANTE'; btn.disabled=false;
}

function carregar(){
  db.ref('FINANCEIRO').once('value',snap=>{
    let arr=[]; snap.forEach(c=>arr.push({id:c.key,...c.val()}));
    arr.sort((a,b)=>new Date(b.data)-new Date(a.data));
    let html=''; let saldo=0;
    arr.forEach(l=>{
      saldo+=parseFloat(l.valor);
      html+=`<div class="flex justify-between items-center bg-zinc-800 p-3 rounded-xl border-l-4 ${l.tipo=='receita'?'border-green-500':'border-red-500'}">
        <div class="text-left text-sm"><b>${l.desc}</b> <span class="text-[10px] text-zinc-500">${l.data}</span><br>
        <span class="${parseFloat(l.valor)>=0?'text-green-400':'text-red-400'} font-bold">R$ ${parseFloat(l.valor).toFixed(2)}</span>
        ${l.urlComprovante?` | <a href="${l.urlComprovante}" target="_blank" class="text-cyan-400 underline text-xs">📎 Ver</a>`:''}
        </div>
        <button onclick="apagar('${l.id}','${l.nomeArquivo||''}')" class="bg-red-900/50 px-2 py-1 rounded text-xs">🗑️</button>
      </div>`;
    });
    document.getElementById('lista').innerHTML=html||'<p class="text-zinc-600 text-sm">Nenhum lançamento</p>';
    const sEl=document.getElementById('saldo'); sEl.innerText='R$ '+saldo.toFixed(2); sEl.className=saldo>=0?'text-green-400':'text-red-400';
  });
}
function apagar(id,nome){if(!confirm('Apagar?'))return; db.ref('FINANCEIRO/'+id).remove().then(()=>{if(nome) storage.ref('comprovantes/'+nome).delete().catch(()=>{}); carregar();});}
</script>
</body>
</html>
