<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DESAFIO DA MinuT&Ra</title>
<script>
const NOME_BANCO = "FTERJ";
const NOME_CLUBE = "FTERJ";
const NOME_CAMPEONATO = "3x7 MinuT&Ra";
const QTD_LOGOS = 2;
const LOGOS = ["logo1.png","logo2.png","logo3.png"];
const SENHA = "minutera2025";
const FULL_ATIVO = true;
const FULL_TEMPO_ESPERA_SEG = 60;
const FULL_TEMPO_EXIBICAO_SEG = 7;
const FULL_QTD_PATROCINADORES = 4;
const RODAPE_TEMPO_EXIBICAO_SEG = 5;

const PATROCINADORES_RODAPE = [
  { prop: "🔥 ADIQUIRA JA A SUA MinuT&Ra 🔥", contato: "<b>Thiago Borges (28) 99944-9010 | Ruam Campos (22) 99834-3139</b>" },
  { prop: "⭐ 3YER - 3D SHOOTER SOLUTIONS ⭐", contato: "<b>@eyer3d no Instagram | Acessórios 3D | Disponiveis aqui no clube </b>" },
  { prop: "🎯 ARMAS E ACESSÓRIOS TACTICAL", contato: "<b>(28) 98877-6655 | @tactical</b>" },
  { prop: "💥 MUNIÇÃO CBC COM DESCONTO", contato: "<b>Whats (28) 99911-2233</b>" }
];
const PATROCINADORES_FULL = [
  { nome: "3YER", arte: "arte_3yer.webp", prop: "3YER" },
  { nome: "TACTICAL", arte: "arte_tactical.webp", prop: "TACTICAL" },
  { nome: "CBC", arte: "arte_cbc.webp", prop: "CBC" },
  { nome: "MINUT&RA", arte: "arte_minutera.webp", prop: "MINUT&RA" }
];
</script>
<style>
body { background: #000; color: #fff; font-family: 'Arial Black', Arial; text-align: center; margin: 0; overflow: hidden; }
.topo { background: linear-gradient(90deg, #FF8C00, #FF4500); padding: 10px 30px; display: flex; align-items: center; justify-content: space-between; border-bottom: 5px solid #FFD700; }
.topo img { height: 75px; border-radius: 10px; background: white; padding: 5px; object-fit: contain; }
.topo h1 { font-size: 2.2vw; margin: 0; color: #000; text-shadow: 2px 2px #FFD700; letter-spacing: 1px; flex: 1; text-align: center; }
.logos-lado { display: flex; gap: 15px; align-items: center; }

/* RELOGIO NO RISCO AZUL - EMBAIXO CENTRO */
.relogio { position: fixed; bottom: 65px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.85); color: #FFD700; font-size: 1.1vw; padding: 5px 18px; border-radius: 20px; border: 1px solid #FF8C00; z-index: 90; font-family: monospace; letter-spacing: 1px; }

#lista { padding: 10px; height: calc(100vh - 145px); overflow: hidden; }
.placar { display: flex; justify-content: space-around; align-items: center; font-size: 1.8vw; margin: 5px 10px; padding: 8px; background: #1a1a1a; border-left: 8px solid #555; border-radius: 10px; color: #fff; }
.placar.p1 { background: linear-gradient(90deg, #FFD700, #FFA500); color: #000; border-left: 8px solid #FFD700; font-size: 2.2vw; font-weight: bold; box-shadow: 0 0 20px #FFD700; }
.placar.p2 { background: linear-gradient(90deg, #C0C0C0, #A9A9A9); color: #000; border-left: 8px solid #C0C0C0; font-size: 2.0vw; font-weight: bold; }
.placar.p3 { background: linear-gradient(90deg, #CD7F32, #8B4513); color: #000; border-left: 8px solid #CD7F32; font-size: 1.9vw; font-weight: bold; }
.pos { font-weight: bold; width: 6%; }.nome { width: 32%; text-align: left; padding-left: 10px; }
.prova { width: 10%; color: #00FFFF; font-size: 1.5vw; }
.total { color: #FFD700; width: 14%; font-weight: bold; }
.detalhe { font-size: 1.2vw; color: #ccc; width: 38%; }
.rodape { background: #000; border-top: 3px solid #FF8C00; padding: 10px 15px; width: 100%; position: fixed; bottom: 0; left: 0; display: none; box-sizing: border-box; height: 55px; }
.rodape-conteudo { display: flex; justify-content: center; align-items: center; gap: 20px; white-space: nowrap; height: 100%; transition: opacity 0.3s; }
.rodape-prop { color: #FFD700; font-size: 1.4vw; font-weight: bold; }
.rodape-contato { color: #fff; font-size: 1.25vw; font-weight: bold; }
#insercao-full { position: fixed; top:0; left:0; width:100vw; height:100vh; background: #000; z-index: 9999; display: none; flex-direction: column; align-items: center; justify-content: center; border: 8px solid #FFD700; }
#prop-gigante { width:100%; height:90%; display:flex; align-items:center; justify-content:center; }
#contato-gigante { position: absolute; bottom: 18px; font-size: 0.9vw; color: #aaa; letter-spacing: 1px; }
.tela-senha { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; background: #0f0f0f; }
.container-operador { display: flex; gap: 15px; padding: 15px; height: calc(100vh - 80px); background: #0f0f0f; }
.coluna-lancamento { width: 40%; background: #1a1a1a; padding: 15px; border-radius: 10px; overflow-y: auto; border: 1px solid #333; }
.coluna-lista { width: 60%; background: #1a1a1a; padding: 15px; border-radius: 10px; overflow-y: auto; border: 1px solid #333; }
.cabecalho { display: flex; justify-content: center; gap: 8px; margin-bottom: 8px; }
.cabecalho input { font-size: 18px; padding: 10px; border-radius: 8px; border: 2px solid #444; font-weight: bold; background: #222; color: #e0e0e0; }
#nome { width: 65%; } #prova { width: 30%; background: #3a3a3a; color: #FFD700; }
.tabela-tiros { width: 100%; margin: 10px auto; border-collapse: collapse; }
.tabela-tiros th { background: #2a2a2a; color: #FFA500; padding: 6px; font-size: 16px; }
.tabela-tiros td { padding: 3px; }
.tabela-tiros input { width: 90%; font-size: 18px; padding: 6px; text-align: center; border: 2px solid #444; border-radius: 5px; background: #222; color: #fff; }
button { font-size: 16px; padding: 10px 15px; margin: 5px 3px; border-radius: 8px; border: none; cursor: pointer; font-weight: bold; }
.btn-lancar { background: #D2691E; color: #fff; }
</style>
</head>
<body>
<div id="tela-senha" class="tela-senha" style="display:none;"><h2>🔒 ACESSO RESTRITO</h2><input type="password" id="inputSenha" placeholder="DIGITE A SENHA" onkeyup="if(event.key==='Enter') verificarSenha()"><button onclick="verificarSenha()">ENTRAR</button><div id="erroSenha"></div></div>

<div id="tela-placar" style="display:none;">
  <div class="topo" id="topo-tv"></div>
  <div id="lista"></div>
  <div class="relogio" id="relogio-tv">00/00/0000 | 00:00:00</div>
  <div id="insercao-full"><div id="prop-gigante"></div><div id="contato-gigante"></div></div>
  <div class="rodape" id="rodape-tv"><div class="rodape-conteudo" id="rodape-conteudo"></div></div>
</div>

<div id="tela-lancamento" style="display:none;">
  <div class="topo" id="topo-operador"></div>
  <div class="container-operador">
    <div class="coluna-lancamento">
      <div style="font-size:12px;color:#888;">X = 12.01 | 10 = 10.0 | F2 Salvar | F3 Nova | F8 Testa Full</div>
      <div id="status" style="font-size:12px;color:#81C784;">Conectando...</div>
      <div class="cabecalho"><input type="text" id="nome" placeholder="NOME" autofocus><input type="text" id="prova" placeholder="Nº PROVA"></div>
      <table class="tabela-tiros"><thead><tr><th>TIRO</th><th>VALOR</th></tr></thead><tbody id="corpo-tabela"></tbody></table>
      <div id="parcial" style="font-size:20px;color:#4FC3F7;">TOTAL: 0.00</div>
      <button class="btn-lancar" id="btnSalvar" onclick="lancar()">SALVAR [F2]</button>
      <button class="btn-lancar" onclick="novaSerie()">NOVA [F3]</button>
      <button class="btn-lancar" onclick="mostrarInsercaoFull()" style="background:#444;">TESTAR FULL [F8]</button>
    </div>
    <div class="coluna-lista"><div id="lista-admin"></div></div>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
<script>
const firebaseConfig = { apiKey: "AIzaSyCTEXeRjxq0_3doBNyWm5AkQ0kmBXmjlSk", authDomain: "placar-minutera.firebaseapp.com", databaseURL: "https://placar-minutera-default-rtdb.firebaseio.com", projectId: "placar-minutera", storageBucket: "placar-minutera.firebasestorage.app", messagingSenderId: "689991648080", appId: "1:689991648080:web:9deeb958183eae23e255" };
firebase.initializeApp(firebaseConfig); const db = firebase.database(); let ranking=[]; let historico=[]; let editandoId=null; let senhaOk=false;

// RELOGIO OFICIAL
let offsetServidor=0; let ultimaSync=0;
async function sincronizarHoraBrasilia(){
  try{ let r=await fetch('https://worldtimeapi.org/api/timezone/America/Sao_Paulo'); let d=await r.json(); offsetServidor=new Date(d.datetime).getTime()-Date.now(); ultimaSync=Date.now(); }
  catch(e){ try{ let r2=await fetch('https://timeapi.io/api/Time/current/zone?timeZone=America/Sao_Paulo'); let d2=await r2.json(); offsetServidor=new Date(d2.dateTime).getTime()-Date.now(); ultimaSync=Date.now(); } catch(e2){ offsetServidor=0; } }
}
function atualizarRelogio(){
  let agora=new Date(Date.now()+offsetServidor);
  let txt=agora.toLocaleDateString('pt-BR')+' | '+agora.toLocaleTimeString('pt-BR');
  let el=document.getElementById('relogio-tv'); if(el) el.innerText=txt;
  if(Date.now()-ultimaSync>600000) sincronizarHoraBrasilia();
}
sincronizarHoraBrasilia(); setInterval(atualizarRelogio,1000); atualizarRelogio();

function montarTopo(id){ let e='<div class="logos-lado">', d='<div class="logos-lado">'; if(QTD_LOGOS>=1) e+=`<img src="${LOGOS[0]}">`; if(QTD_LOGOS>=2) d+=`<img src="${LOGOS[1]}">`; if(QTD_LOGOS>=3) d+=`<img src="${LOGOS[2]}">`; e+='</div>'; d+='</div>'; document.getElementById(id).innerHTML=`${e}<h1>${NOME_CAMPEONATO} - ${NOME_CLUBE}</h1>${d}`; }
montarTopo('topo-tv'); montarTopo('topo-operador');
let indiceRodape=0;
function rotacionarRodape(){ const r=document.getElementById('rodape-conteudo'); if(!r||PATROCINADORES_RODAPE.length==0) return; r.style.opacity=0; setTimeout(()=>{ let p=PATROCINADORES_RODAPE[indiceRodape]; r.innerHTML=`<div class="rodape-prop">${p.prop}</div><div class="rodape-contato">${p.contato}</div>`; r.style.opacity=1; indiceRodape=(indiceRodape+1)%PATROCINADORES_RODAPE.length; },300); }
let mostrando=false;
function mostrarInsercaoFull(){
  if(!FULL_ATIVO||mostrando) return;
  mostrando=true;
  let lista=PATROCINADORES_FULL.slice(0,FULL_QTD_PATROCINADORES);
  if(!lista.length){ mostrando=false; return; }
  let total=lista.length*FULL_TEMPO_EXIBICAO_SEG; let resto=total; let idx=0;
  document.getElementById('insercao-full').style.display='flex';
  document.getElementById('contato-gigante').innerHTML=`VOLTAMOS AO PLACAR EM <b style="color:#FFD700;">${resto}s</b>`;
  let timer=setInterval(()=>{ resto--; let el=document.getElementById('contato-gigante'); if(el) el.innerHTML=`VOLTAMOS AO PLACAR EM <b style="color:#FFD700;">${resto}s</b>`; if(resto<=0) clearInterval(timer); },1000);
  function prox(){
    if(idx>=lista.length){ clearInterval(timer); document.getElementById('insercao-full').style.display='none'; mostrando=false; return; }
    let p=lista[idx]; let el=document.getElementById('prop-gigante');
    if(p.arte) el.innerHTML=`<img src="${p.arte}" style="max-width:95vw; max-height:85vh; border-radius:15px; box-shadow:0 0 50px #FFD700; object-fit:contain;">`;
    else el.innerHTML=`<div style='font-size:4.5vw; color:#FFD700; font-weight:bold;'>${p.prop}</div>`;
    setTimeout(()=>{ idx++; prox(); }, FULL_TEMPO_EXIBICAO_SEG*1000);
  }
  prox();
}
const urlParams=new URLSearchParams(window.location.search); const modo=(urlParams.get('modo')||'').toLowerCase();
if(modo==='tv'||modo==='celular'){
  document.getElementById('tela-senha').style.display='none';
  document.getElementById('tela-placar').style.display='block';
  document.getElementById('rodape-tv').style.display='block';
  rotacionarRodape(); setInterval(rotacionarRodape, RODAPE_TEMPO_EXIBICAO_SEG*1000);
  if(FULL_ATIVO) setInterval(mostrarInsercaoFull, FULL_TEMPO_ESPERA_SEG*1000);
  iniciarFirebase();
} else {
  document.getElementById('tela-senha').style.display='flex';
}
function verificarSenha(){ let s=document.getElementById('inputSenha').value; if(s===SENHA){ senhaOk=true; document.getElementById('tela-senha').style.display='none'; document.getElementById('tela-lancamento').style.display='block'; montarTabela(); iniciarFirebase(); } else { document.getElementById('erroSenha').innerText="SENHA INCORRETA!"; } }
function iniciarFirebase(){
  db.ref('.info/connected').on('value', snap=>{ let el=document.getElementById('status'); if(el){ el.innerText=snap.val()?'Online: '+new Date().toLocaleTimeString():'Conectando...'; } });
  db.ref(NOME_BANCO).on('value', snap=>{ ranking=[]; historico=[]; snap.forEach(c=>{ let v=c.val(); if(v&&v.contagem) { ranking.push(v); historico.push(v); } }); ranking.sort((a,b)=>b.pontos-a.pontos); if(modo==='tv'||modo==='celular') atualizarTela(); else atualizarListaAdmin(); });
}
function montarTabela(){ let h=""; for(let i=1;i<=10;i++) h+=`<tr><td>${i}º</td><td><input type="text" id="t${i}" onkeyup="proximoTiro(event,${i})" oninput="calcularParcial()"></td></tr>`; document.getElementById('corpo-tabela').innerHTML=h; }
function proximoTiro(e,n){ if(e.key==='Enter'||e.key==='Tab'){ e.preventDefault(); if(n<10) document.getElementById('t'+(n+1)).focus(); else document.getElementById('btnSalvar').focus(); } }
function calcularParcial(){ let t=0; for(let i=1;i<=10;i++) t+=valorTiro(document.getElementById('t'+i).value); document.getElementById('parcial').innerText=`TOTAL: ${t.toFixed(2)}`; }
function valorTiro(v){ v=v.toUpperCase(); if(v==='X') return 12.01; let n=parseFloat(v); return isNaN(n)?0:n; }
function contarTiros(tiros){ let c={x12_01:0,x10:0,x9:0,x8:0,x7:0,x6:0,x5:0,x4:0,x3:0,x2:0,x1:0,x0:0}; tiros.forEach(t=>{ let v=valorTiro(t); if(v===12.01) c.x12_01++; else c['x'+Math.floor(v)]++; }); return c; }
function gerarID(){ return 'serie_'+Date.now()+'_'+Math.random().toString(36).substr(2,5); }
function lancar(){ let nome=document.getElementById('nome').value.toUpperCase(); let prova=document.getElementById('prova').value.toUpperCase(); if(!nome||!prova) return alert("Preencha Nome e Prova"); let tiros=[]; let pts=0; for(let i=1;i<=10;i++){ let v=document.getElementById('t'+i).value; tiros.push(v); pts+=valorTiro(v); } let cont=contarTiros(tiros); let id=editandoId?editandoId:gerarID(); db.ref(NOME_BANCO+'/'+id).set({id,nome,prova,pontos:pts,tiros,contagem:cont,timestamp:Date.now()}).then(()=>{ editandoId=null; novaSerie(); }); }
function novaSerie(){ editandoId=null; document.getElementById('nome').value=""; document.getElementById('prova').value=""; for(let i=1;i<=10;i++) document.getElementById('t'+i).value=""; document.getElementById('parcial').innerText="TOTAL: 0.00"; document.getElementById('nome').focus(); }
function atualizarTela(){ let html=""; for(let i=0;i<10&&i<ranking.length;i++){ let a=ranking[i]; html+=`<div class="placar ${i==0?'p1':i==1?'p2':i==2?'p3':''}"><span class="pos">${i+1}º</span><span class="nome">${a.nome}</span><span class="prova">P:${a.prova}</span><span class="total">${a.pontos.toFixed(2)}</span><span class="detalhe">X:${a.contagem.x12_01} | 10:${a.contagem.x10} | 9:${a.contagem.x9}</span></div>`; } document.getElementById('lista').innerHTML=html||"<div class='placar'>AGUARDANDO</div>"; }
function atualizarListaAdmin(){ let h=""; historico.forEach((a,i)=>{ h+=`<div style="display:flex;justify-content:space-between;color:#fff;border-bottom:1px solid #333;padding:4px;">${i+1}º ${a.nome} P:${a.prova} ${a.pontos.toFixed(2)}</div>`; }); document.getElementById('lista-admin').innerHTML=h; }

// ATALHOS F2 F3 F8 - CORRIGIDO
document.addEventListener('keydown', function(e){
  if(e.key==='F2' && senhaOk){ e.preventDefault(); lancar(); }
  if(e.key==='F3' && senhaOk){ e.preventDefault(); novaSerie(); }
  if(e.key==='F8'){ e.preventDefault(); mostrarInsercaoFull(); }
});
</script>
</body>
</html>